# Supabase Configuration
# Replace with your actual project URL and anon/publishable public key from Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_publishable_or_anon_key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Default Library Code
EXPO_PUBLIC_DEFAULT_LIBRARY_CODE=BW-MAIN
